APP_NAME="NestJS Boilerplate"
APP_ENV=local
APP_DEBUG=1
APP_PORT=5000
APP_URL=http://localhost:${APP_PORT}

DB_TYPE=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=nestjs_boilerplate
DB_DEBUG=0

# Two different random values, the API does not start without them.
# `node cli init` fills them in .env; or use `openssl rand -base64 32`.
JWT_SECRET=
RESET_PASSWORD_SECRET=
