APP_NAME="NestJS Boilerplate"
APP_ENV=local
APP_DEBUG=1
APP_PORT=5000
APP_URL=http://localhost:${APP_PORT}
# browser origins allowed to call the API, comma separated (empty: none)
CORS_ORIGINS=
# set when running behind a proxy/load balancer, e.g. 1 (see config/app.ts)
APP_TRUST_PROXY=
# per IP and route, for login, signup and password reset
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

DB_TYPE=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=nestjs_boilerplate
DB_DEBUG=0

# Two different random values, the API does not start without them.
# `node cli init` fills them in .env; or use `openssl rand -base64 32`.
JWT_SECRET=
RESET_PASSWORD_SECRET=
