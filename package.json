{
  "name": "nestjs-boilerplate",
  "version": "1.0.0",
  "description": "A production ready NestJS boilerplate with batteries included. No Kidding!",
  "author": "Squareboat <hi@squareboat.com>",
  "private": false,
  "license": "MIT",
  "keywords": [
    "nestjs-boilerplate",
    "nestjs-objection",
    "nestjs-starter-template",
    "nestjs-template"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/squareboat/nestjs-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/squareboat/nestjs-boilerplate/issues"
  },
  "homepage": "https://github.com/squareboat/nestjs-boilerplate",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:dev": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/nestjs-boilerplate/test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.782.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@sentry/node": "^9.12.0",
    "@squareboat/nest-console": "^1.1.4",
    "@squareboat/nest-events": "^0.1.1",
    "@squareboat/nest-queue": "^0.1.5",
    "@squareboat/nestjs-localization": "^0.0.5",
    "@squareboat/nestjs-objection": "^0.3.9",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^4.1.0",
    "eslint-plugin-import": "^2.31.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "libphonenumber-js": "^1.12.6",
    "pg": "^8.11.1",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "rxjs": "^7.8.1",
    "ulid": "^3.0.0",
    "validatorjs": "^3.22.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.1.9",
    "@nestjs/schematics": "^10.0.1",
    "@types/date-fns": "^2.5.3",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.3",
    "@types/lodash": "^4.14.195",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint-config-prettier": "^8.8.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/platform-express": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "@libs/boat/(.*)": "<rootDir>/libs/boat/src/$1",
      "@libs/boat": "<rootDir>/libs/boat/src"
    }
  }
}
